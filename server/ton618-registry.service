[Unit]
Description=TON618 package registry
After=network.target

[Service]
User=ton618
WorkingDirectory=/opt/ton618-registry/app/server
ExecStart=/usr/bin/python3 registry_server.py serve --db /opt/ton618-registry/registry.db --host 127.0.0.1 --port 8080 --behind-proxy
Restart=always
RestartSec=3
# Environment=TON618_REGISTRATION=closed
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ton618-registry
PrivateTmp=true

[Install]
WantedBy=multi-user.target
